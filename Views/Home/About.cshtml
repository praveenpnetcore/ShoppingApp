@{
    ViewData["Title"] = "About Us";
}

<section class="py-5">
    <div class="container">
        <!-- Hero -->
        <div class="text-center mb-5" data-aos="fade-up">
            <h1 class="display-4 fw-bold">About ShoppingApp</h1>
            <p class="lead text-muted">Your trusted online shopping destination since 2020</p>
        </div>

        <div class="row g-5 align-items-center mb-5">
            <div class="col-lg-6" data-aos="fade-right">
                <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=600" 
                     alt="About Us" class="img-fluid rounded-4 shadow-lg">
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <h2 class="fw-bold mb-4">Our Story</h2>
                <p class="text-muted mb-4">
                    ShoppingApp was founded with a simple mission: to make online shopping easy, affordable, and enjoyable 
                    for everyone in India. We started as a small e-commerce platform and have grown to become one of the 
                    most trusted online shopping destinations.
                </p>
                <p class="text-muted mb-4">
                    We believe that everyone deserves access to quality products at fair prices. That's why we work 
                    directly with manufacturers and brands to bring you the best deals without compromising on quality.
                </p>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="d-flex align-items-center">
                            <div class="feature-icon bg-primary-subtle rounded-circle me-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-box-seam text-primary"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">10,000+</h5>
                                <small class="text-muted">Products</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center">
                            <div class="feature-icon bg-success-subtle rounded-circle me-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-people text-success"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">50,000+</h5>
                                <small class="text-muted">Happy Customers</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Values -->
        <div class="text-center mb-5" data-aos="fade-up">
            <h2 class="fw-bold">Our Values</h2>
            <p class="text-muted">What drives us every day</p>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="card-body">
                        <div class="feature-icon bg-primary-subtle rounded-circle mx-auto mb-3" style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-gem text-primary fs-3"></i>
                        </div>
                        <h5 class="fw-bold">Quality First</h5>
                        <p class="text-muted mb-0">We never compromise on quality. Every product goes through rigorous quality checks before reaching you.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="card-body">
                        <div class="feature-icon bg-success-subtle rounded-circle mx-auto mb-3" style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-heart text-success fs-3"></i>
                        </div>
                        <h5 class="fw-bold">Customer Love</h5>
                        <p class="text-muted mb-0">Our customers are at the heart of everything we do. Your satisfaction is our top priority.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="card-body">
                        <div class="feature-icon bg-warning-subtle rounded-circle mx-auto mb-3" style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-lightning text-warning fs-3"></i>
                        </div>
                        <h5 class="fw-bold">Fast Delivery</h5>
                        <p class="text-muted mb-0">We understand the excitement of receiving your order. That's why we ensure quick and safe delivery.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
