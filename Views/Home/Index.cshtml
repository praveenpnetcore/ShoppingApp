@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container position-relative">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6" data-aos="fade-right">
                <span class="badge bg-warning text-dark mb-3 px-3 py-2">
                    <i class="bi bi-lightning-charge-fill me-1"></i>Special Offer
                </span>
                <h1 class="display-3 fw-bold text-white mb-4">
                    Discover Amazing Products
                </h1>
                <p class="lead text-white-50 mb-4">
                    Shop the latest trends with exclusive discounts. Get <strong class="text-warning">@Model.DiscountPercentage% OFF</strong> on products above ₹@Model.MinimumAmountForDiscount.ToString("N0")!
                </p>
                <div class="d-flex gap-3">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-bag me-2"></i>Shop Now
                    </a>
                    <a href="#categories" class="btn btn-outline-light btn-lg px-4">
                        Browse Categories
                    </a>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block" data-aos="fade-left">
                <img src="https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?w=600" 
                     alt="Shopping" class="img-fluid rounded-4 shadow-lg hero-image">
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section id="categories" class="py-5">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h2 class="fw-bold">Shop by Category</h2>
            <p class="text-muted">Explore our wide range of categories</p>
        </div>
        <div class="row g-4">
            @foreach (var category in Model.Categories)
            {
                <div class="col-6 col-md-4 col-lg-2" data-aos="zoom-in">
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id" 
                       class="text-decoration-none">
                        <div class="category-card text-center p-4 rounded-4 bg-white shadow-sm h-100">
                            <div class="category-icon mb-3">
                                @{
                                    var icon = category.Name switch
                                    {
                                        "Electronics" => "bi-laptop",
                                        "Clothing" => "bi-bag",
                                        "Home & Kitchen" => "bi-house",
                                        "Books" => "bi-book",
                                        "Sports & Fitness" => "bi-bicycle",
                                        _ => "bi-grid"
                                    };
                                }
                                <i class="bi @icon fs-1 text-primary"></i>
                            </div>
                            <h6 class="mb-0 text-dark">@category.Name</h6>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Products -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4" data-aos="fade-up">
            <div>
                <h2 class="fw-bold mb-0">Featured Products</h2>
                <p class="text-muted mb-0">Discover our top picks for you</p>
            </div>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                View All <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        
        <div class="row g-4">
            @foreach (var product in Model.FeaturedProducts)
            {
                var isDiscountApplicable = product.Price >= Model.MinimumAmountForDiscount;
                var discountedPrice = isDiscountApplicable 
                    ? product.Price - (product.Price * Model.DiscountPercentage / 100)
                    : product.Price;
                
                <div class="col-6 col-md-4 col-lg-3" data-aos="fade-up">
                    <div class="product-card card h-100 border-0 shadow-sm">
                        @if (isDiscountApplicable)
                        {
                            <div class="discount-badge">
                                <span class="badge bg-danger">@Model.DiscountPercentage% OFF</span>
                            </div>
                        }
                        <div class="product-image-wrapper">
                            <img src="@product.ImageUrl" class="card-img-top product-image" alt="@product.Name"
                                 onerror="this.src='https://via.placeholder.com/300x200?text=No+Image'">
                            <div class="product-overlay">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" 
                                   class="btn btn-light btn-sm">
                                    <i class="bi bi-eye"></i> Quick View
                                </a>
                            </div>
                        </div>
                        <div class="card-body">
                            <span class="badge bg-light text-dark mb-2">@product.Category?.Name</span>
                            <h6 class="card-title text-truncate">@product.Name</h6>
                            <div class="d-flex align-items-center mb-2">
                                @if (isDiscountApplicable)
                                {
                                    <span class="text-decoration-line-through text-muted me-2">₹@product.Price.ToString("N0")</span>
                                    <span class="fw-bold text-success fs-5">₹@discountedPrice.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-primary fs-5">₹@product.Price.ToString("N0")</span>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary btn-sm flex-grow-1 add-to-cart-btn" 
                                        data-product-id="@product.Id">
                                    <i class="bi bi-cart-plus me-1"></i>Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
