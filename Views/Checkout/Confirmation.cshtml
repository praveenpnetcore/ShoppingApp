@model Order
@{
    ViewData["Title"] = "Order Confirmation";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Success Message -->
                <div class="text-center mb-5" data-aos="zoom-in">
                    <div class="success-icon mb-4">
                        <i class="bi bi-check-circle-fill text-success display-1"></i>
                    </div>
                    <h1 class="fw-bold text-success mb-3">Order Placed Successfully!</h1>
                    <p class="lead text-muted">Thank you for your order. We've received your order and will begin processing it soon.</p>
                </div>

                <!-- Order Details Card -->
                <div class="card border-0 shadow-sm mb-4" data-aos="fade-up">
                    <div class="card-header bg-primary text-white py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Order Details</h5>
                            <span class="badge bg-light text-primary">@Model.OrderNumber</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <h6 class="text-muted mb-2">Order Information</h6>
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <td class="text-muted">Order Number:</td>
                                        <td class="fw-bold">@Model.OrderNumber</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Order Date:</td>
                                        <td>@Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Payment Method:</td>
                                        <td>@Model.PaymentMethod</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Status:</td>
                                        <td>
                                            <span class="badge bg-warning text-dark">@Model.Status</span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted mb-2">Shipping Address</h6>
                                <address class="mb-0">
                                    <strong>@Model.CustomerName</strong><br>
                                    @Model.ShippingAddress<br>
                                    @Model.City, @Model.State - @Model.PinCode<br>
                                    <i class="bi bi-telephone me-1"></i>@Model.Phone<br>
                                    <i class="bi bi-envelope me-1"></i>@Model.Email
                                </address>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Items -->
                <div class="card border-0 shadow-sm mb-4" data-aos="fade-up">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0"><i class="bi bi-box me-2 text-primary"></i>Items Ordered</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Product</th>
                                        <th class="text-center">Price</th>
                                        <th class="text-center">Qty</th>
                                        <th class="text-end pe-4">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.OrderItems!)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    @if (item.Product != null)
                                                    {
                                                        <img src="@item.Product.ImageUrl" alt="@item.ProductName" 
                                                             class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;"
                                                             onerror="this.src='https://via.placeholder.com/50?text=No+Image'">
                                                    }
                                                    <span>@item.ProductName</span>
                                                </div>
                                            </td>
                                            <td class="text-center">₹@item.UnitPrice.ToString("N0")</td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end pe-4 fw-bold">₹@item.TotalPrice.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Price Summary -->
                <div class="card border-0 shadow-sm mb-4" data-aos="fade-up">
                    <div class="card-body">
                        <div class="row justify-content-end">
                            <div class="col-md-6">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Subtotal:</span>
                                    <span>₹@Model.SubTotal.ToString("N0")</span>
                                </div>
                                @if (Model.DiscountAmount > 0)
                                {
                                    <div class="d-flex justify-content-between mb-2 text-success">
                                        <span><i class="bi bi-tag-fill me-1"></i>Discount (@Model.DiscountPercentage%):</span>
                                        <span>- ₹@Model.DiscountAmount.ToString("N0")</span>
                                    </div>
                                }
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Shipping:</span>
                                    <span class="text-success">FREE</span>
                                </div>
                                <hr>
                                <div class="d-flex justify-content-between">
                                    <span class="fw-bold fs-5">Total Paid:</span>
                                    <span class="fw-bold fs-4 text-primary">₹@Model.TotalAmount.ToString("N0")</span>
                                </div>
                                @if (Model.DiscountAmount > 0)
                                {
                                    <div class="alert alert-success py-2 mt-3 mb-0">
                                        <small>
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            You saved <strong>₹@Model.DiscountAmount.ToString("N0")</strong> on this order!
                                        </small>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="text-center" data-aos="fade-up">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg me-2">
                        <i class="bi bi-bag me-2"></i>Continue Shopping
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-house me-2"></i>Go to Home
                    </a>
                </div>

                <!-- Expected Delivery -->
                <div class="text-center mt-5 p-4 bg-light rounded-4" data-aos="fade-up">
                    <i class="bi bi-truck text-primary fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold">Expected Delivery</h5>
                    <p class="text-muted mb-0">Your order will be delivered within <strong>5-7 business days</strong></p>
                    <p class="text-muted mb-0">You will receive an email with tracking details once shipped.</p>
                </div>
            </div>
        </div>
    </div>
</section>
