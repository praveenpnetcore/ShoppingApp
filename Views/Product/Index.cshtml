@model ProductListViewModel
@{
    ViewData["Title"] = "Products";
}

<section class="py-5">
    <div class="container">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active">Products</li>
            </ol>
        </nav>

        <div class="row">
            <!-- Sidebar Filters -->
            <div class="col-lg-3 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title fw-bold mb-3">
                            <i class="bi bi-funnel me-2"></i>Categories
                        </h5>
                        <div class="list-group list-group-flush">
                            <a asp-controller="Product" asp-action="Index" 
                               class="list-group-item list-group-item-action @(Model.SelectedCategoryId == null ? "active" : "")">
                                <i class="bi bi-grid me-2"></i>All Products
                            </a>
                            @foreach (var category in Model.Categories)
                            {
                                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id"
                                   class="list-group-item list-group-item-action @(Model.SelectedCategoryId == category.Id ? "active" : "")">
                                    @{
                                        var icon = category.Name switch
                                        {
                                            "Electronics" => "bi-laptop",
                                            "Clothing" => "bi-bag",
                                            "Home & Kitchen" => "bi-house",
                                            "Books" => "bi-book",
                                            "Sports & Fitness" => "bi-bicycle",
                                            _ => "bi-tag"
                                        };
                                    }
                                    <i class="bi @icon me-2"></i>@category.Name
                                </a>
                            }
                        </div>
                    </div>
                </div>

                <!-- Discount Info Card -->
                <div class="card border-0 shadow-sm mt-4 bg-gradient-primary text-white">
                    <div class="card-body discount-info-card">
                        <h6 class="fw-bold mb-2">
                            <i class="bi bi-percent me-2"></i>Special Offer!
                        </h6>
                        <p class="mb-0 small">
                            Get <strong>@Model.DiscountPercentage% OFF</strong> on products above 
                            <strong>₹@Model.MinimumAmountForDiscount.ToString("N0")</strong>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Products Grid -->
            <div class="col-lg-9">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1">
                            @if (!string.IsNullOrEmpty(Model.SearchTerm))
                            {
                                <text>Search Results for "@Model.SearchTerm"</text>
                            }
                            else if (Model.SelectedCategoryId.HasValue)
                            {
                                @Model.Categories.FirstOrDefault(c => c.Id == Model.SelectedCategoryId)?.Name
                            }
                            else
                            {
                                <text>All Products</text>
                            }
                        </h4>
                        <span class="text-muted">@Model.Products.Count() products found</span>
                    </div>
                    <div class="d-flex gap-2">
                        <select class="form-select form-select-sm" style="width: auto;">
                            <option>Sort by: Featured</option>
                            <option>Price: Low to High</option>
                            <option>Price: High to Low</option>
                            <option>Newest First</option>
                        </select>
                    </div>
                </div>

                @if (!Model.Products.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-search display-1 text-muted"></i>
                        <h5 class="mt-3">No products found</h5>
                        <p class="text-muted">Try adjusting your search or filter criteria</p>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-primary">View All Products</a>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var product in Model.Products)
                        {
                            var isDiscountApplicable = product.Price >= Model.MinimumAmountForDiscount;
                            var discountedPrice = isDiscountApplicable 
                                ? product.Price - (product.Price * Model.DiscountPercentage / 100)
                                : product.Price;
                            
                            <div class="col-6 col-md-4" data-aos="fade-up">
                                <div class="product-card card h-100 border-0 shadow-sm">
                                    @if (isDiscountApplicable)
                                    {
                                        <div class="discount-badge">
                                            <span class="badge bg-danger">@Model.DiscountPercentage% OFF</span>
                                        </div>
                                    }
                                    <div class="product-image-wrapper">
                                        <img src="@product.ImageUrl" class="card-img-top product-image" alt="@product.Name"
                                             onerror="this.src='https://via.placeholder.com/300x200?text=No+Image'">
                                        <div class="product-overlay">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" 
                                               class="btn btn-light btn-sm">
                                                <i class="bi bi-eye"></i> Quick View
                                            </a>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <span class="badge bg-light text-dark mb-2">@product.Category?.Name</span>
                                        <h6 class="card-title text-truncate" title="@product.Name">@product.Name</h6>
                                        <p class="card-text text-muted small text-truncate">@product.Description</p>
                                        <div class="d-flex align-items-center mb-2">
                                            @if (isDiscountApplicable)
                                            {
                                                <span class="text-decoration-line-through text-muted me-2 small">₹@product.Price.ToString("N0")</span>
                                                <span class="fw-bold text-success">₹@discountedPrice.ToString("N0")</span>
                                            }
                                            else
                                            {
                                                <span class="fw-bold text-primary">₹@product.Price.ToString("N0")</span>
                                            }
                                        </div>
                                        @if (product.StockQuantity > 0)
                                        {
                                            <span class="badge bg-success-subtle text-success mb-2">
                                                <i class="bi bi-check-circle me-1"></i>In Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger mb-2">
                                                <i class="bi bi-x-circle me-1"></i>Out of Stock
                                            </span>
                                        }
                                        <div class="d-grid">
                                            <button class="btn btn-primary btn-sm add-to-cart-btn" 
                                                    data-product-id="@product.Id"
                                                    @(product.StockQuantity <= 0 ? "disabled" : "")>
                                                <i class="bi bi-cart-plus me-1"></i>Add to Cart
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>
