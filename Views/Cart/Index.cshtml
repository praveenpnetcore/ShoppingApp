@model CartSummaryViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<section class="py-5">
    <div class="container">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active">Shopping Cart</li>
            </ol>
        </nav>

        <h2 class="fw-bold mb-4">
            <i class="bi bi-cart3 me-2"></i>Shopping Cart
            <span class="badge bg-primary ms-2">@Model.TotalItems items</span>
        </h2>

        @if (!Model.CartItems.Any())
        {
            <div class="text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-cart-x display-1 text-muted"></i>
                </div>
                <h4 class="mb-3">Your cart is empty</h4>
                <p class="text-muted mb-4">Looks like you haven't added any items to your cart yet.</p>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="bi bi-bag me-2"></i>Continue Shopping
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- Cart Items -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="ps-4">Product</th>
                                            <th class="text-center">Price</th>
                                            <th class="text-center">Quantity</th>
                                            <th class="text-center">Total</th>
                                            <th class="text-center pe-4">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="cartItemsBody">
                                        @foreach (var item in Model.CartItems)
                                        {
                                            <tr class="cart-item-row" data-cart-item-id="@item.CartItemId">
                                                <td class="ps-4">
                                                    <div class="d-flex align-items-center">
                                                        <img src="@item.ProductImage" alt="@item.ProductName" 
                                                             class="rounded-3 me-3" style="width: 80px; height: 80px; object-fit: cover;"
                                                             onerror="this.src='https://via.placeholder.com/80?text=No+Image'">
                                                        <div>
                                                            <h6 class="mb-1">@item.ProductName</h6>
                                                            @if (item.IsDiscountApplicable)
                                                            {
                                                                <span class="badge bg-success-subtle text-success">
                                                                    <i class="bi bi-tag me-1"></i>@item.DiscountPercentage% OFF Applied
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    @if (item.IsDiscountApplicable)
                                                    {
                                                        <div>
                                                            <span class="text-decoration-line-through text-muted small d-block">
                                                                ₹@item.UnitPrice.ToString("N0")
                                                            </span>
                                                            <span class="text-success fw-bold">
                                                                ₹@((item.UnitPrice - (item.UnitPrice * item.DiscountPercentage / 100)).ToString("N0"))
                                                            </span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="fw-bold">₹@item.UnitPrice.ToString("N0")</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <div class="d-flex align-items-center justify-content-center">
                                                        <button class="btn btn-outline-secondary btn-sm cart-qty-btn" 
                                                                data-action="decrease" data-cart-item-id="@item.CartItemId">
                                                            <i class="bi bi-dash"></i>
                                                        </button>
                                                        <span class="mx-3 fw-bold cart-item-qty">@item.Quantity</span>
                                                        <button class="btn btn-outline-secondary btn-sm cart-qty-btn" 
                                                                data-action="increase" data-cart-item-id="@item.CartItemId">
                                                            <i class="bi bi-plus"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    @if (item.IsDiscountApplicable)
                                                    {
                                                        <div>
                                                            <span class="text-decoration-line-through text-muted small d-block">
                                                                ₹@item.TotalPrice.ToString("N0")
                                                            </span>
                                                            <span class="text-success fw-bold cart-item-total">
                                                                ₹@item.FinalPrice.ToString("N0")
                                                            </span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="fw-bold cart-item-total">₹@item.FinalPrice.ToString("N0")</span>
                                                    }
                                                </td>
                                                <td class="text-center pe-4">
                                                    <button class="btn btn-outline-danger btn-sm remove-item-btn" 
                                                            data-cart-item-id="@item.CartItemId" title="Remove">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Continue Shopping -->
                    <div class="mt-4">
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                        </a>
                    </div>
                </div>

                <!-- Order Summary -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm sticky-lg-top" style="top: 100px;">
                        <div class="card-header bg-primary text-white py-3">
                            <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Order Summary</h5>
                        </div>
                        <div class="card-body" id="orderSummary">
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Subtotal (@Model.TotalItems items)</span>
                                <span class="fw-bold" id="cartSubtotal">₹@Model.SubTotal.ToString("N0")</span>
                            </div>
                            
                            @if (Model.TotalDiscount > 0)
                            {
                                <div class="d-flex justify-content-between mb-3 text-success">
                                    <span>
                                        <i class="bi bi-tag-fill me-1"></i>Discount (@Model.DiscountPercentage%)
                                    </span>
                                    <span class="fw-bold" id="cartDiscount">- ₹@Model.TotalDiscount.ToString("N0")</span>
                                </div>
                            }

                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Shipping</span>
                                <span class="text-success fw-bold">FREE</span>
                            </div>

                            <hr>

                            <div class="d-flex justify-content-between mb-4">
                                <span class="fw-bold fs-5">Total</span>
                                <span class="fw-bold fs-4 text-primary" id="cartTotal">₹@Model.GrandTotal.ToString("N0")</span>
                            </div>

                            @if (Model.TotalDiscount > 0)
                            {
                                <div class="alert alert-success py-2 mb-4">
                                    <small>
                                        <i class="bi bi-check-circle me-1"></i>
                                        You're saving <strong>₹@Model.TotalDiscount.ToString("N0")</strong> on this order!
                                    </small>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info py-2 mb-4">
                                    <small>
                                        <i class="bi bi-info-circle me-1"></i>
                                        Add products above ₹@Model.MinimumAmountForDiscount.ToString("N0") to get @Model.DiscountPercentage% discount!
                                    </small>
                                </div>
                            }

                            <a  class="btn btn-primary btn-lg w-100">
                                <i class="bi bi-lock me-2"></i>Proceed to Checkout
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Quantity buttons in cart
        document.querySelectorAll('.cart-qty-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const cartItemId = this.dataset.cartItemId;
                const action = this.dataset.action;
                const row = document.querySelector(`[data-cart-item-id="${cartItemId}"]`);
                const qtySpan = row.querySelector('.cart-item-qty');
                let currentQty = parseInt(qtySpan.textContent);
                
                if (action === 'increase') {
                    currentQty++;
                } else if (action === 'decrease' && currentQty > 1) {
                    currentQty--;
                } else if (action === 'decrease' && currentQty === 1) {
                    // Remove item if quantity becomes 0
                    removeCartItem(cartItemId);
                    return;
                }
                
                updateCartQuantity(cartItemId, currentQty);
            });
        });

        // Remove item buttons
        document.querySelectorAll('.remove-item-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const cartItemId = this.dataset.cartItemId;
                removeCartItem(cartItemId);
            });
        });
    });

    function updateCartQuantity(cartItemId, quantity) {
        fetch('/Cart/UpdateQuantity', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `cartItemId=${cartItemId}&quantity=${quantity}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload(); // Refresh to show updated totals
            }
        });
    }

    function removeCartItem(cartItemId) {
        if (confirm('Are you sure you want to remove this item?')) {
            fetch('/Cart/RemoveItem', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `cartItemId=${cartItemId}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            });
        }
    }
</script>
}
