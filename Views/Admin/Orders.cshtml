@model IEnumerable<Order>
@{
    ViewData["Title"] = "Orders";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-receipt me-2 text-primary"></i>Orders</h4>
</div>

<div class="card table-card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Order #</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th class="pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="ps-4"><strong>@order.OrderNumber</strong></td>
                            <td>
                                <div>@order.CustomerName</div>
                                <small class="text-muted">@order.Email</small>
                            </td>
                            <td>@order.OrderDate.ToString("dd MMM yyyy")<br><small class="text-muted">@order.OrderDate.ToString("hh:mm tt")</small></td>
                            <td>@order.OrderItems?.Count items</td>
                            <td class="fw-bold">₹@order.TotalAmount.ToString("N0")</td>
                            <td>
                                @{
                                    var statusClass = order.Status switch
                                    {
                                        OrderStatus.Pending => "warning",
                                        OrderStatus.Confirmed => "info",
                                        OrderStatus.Processing => "primary",
                                        OrderStatus.Shipped => "secondary",
                                        OrderStatus.Delivered => "success",
                                        OrderStatus.Cancelled => "danger",
                                        _ => "secondary"
                                    };
                                }
                                <span class="badge bg-@statusClass">@order.Status</span>
                            </td>
                            <td class="pe-4">
                                <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
